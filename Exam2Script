# =====================================================================
# PART F — MULTIPLE REGRESSION STANDARD ERRORS (Problem Set 12)
#   df = n - K - 1     (K = number of x's, NOT counting intercept)
#   sigma-hat = sqrt(SSR / df)
#   SST_j = (n-1) * S_Xj^2  = sum((xj - mean(xj))^2)
#   R2_j  = R^2 from regressing X_j on the OTHER x's (Y not involved)
#   se(b_j) = sigma-hat / sqrt(SST_j * (1 - R2_j))
# =====================================================================

# ---- F1. sigma-hat  (PS12 #4: K=4, n=34, SSR=1561) -------------------
K <- 4; n <- 34; SSR <- 1561              # <- change these
df <- n - K - 1; r(c(df = df, sigma_hat = sqrt(SSR / df)))

# ---- F2. SST_j from n and SD  (PS12 #5: n=52, S=4.3) ------------------
n <- 52; S <- 4.3                          # <- change (if given variance, S <- sqrt(var))
r((n - 1) * S^2)

# ---- F3. se(b_j)  (PS12 #6: sigma-hat=11.5, SST_j=329, R2_j=0.34) ----
sig <- 11.5; SSTj <- 329; R2j <- 0.34      # <- change these
r(sig / sqrt(SSTj * (1 - R2j)))

# ---- F4. Var(b_j) with true sigma^2 ----------------------------------
sigma2 <- 80; SSTj <- 17; R2j <- 0         # <- change these
r(sigma2 / (SSTj * (1 - R2j)))

# ---- F5. se BY HAND FROM DATA, every piece (PS12 #8-13, hprice1, bdrms)
# Change: the formula, the dataset, xj (the variable you want), and the other x's.
reg <- lm(price ~ sqrft + bdrms + lotsize, data = hprice1)   # <- change
xj  <- "bdrms"                                               # <- change
d   <- model.frame(reg)              # ONLY rows lm() used (handles missing values)
n   <- nobs(reg); K <- length(coef(reg)) - 1; df <- n - K - 1
SSR <- sum(reg$residuals^2); sigma_hat <- sqrt(SSR / df)
SST_j <- sum((d[[xj]] - mean(d[[xj]]))^2)
R2_j  <- summary(lm(bdrms ~ sqrft + lotsize, data = d))$r.squared  # <- xj ~ OTHER x's
se_j  <- sigma_hat / sqrt(SST_j * (1 - R2_j))
r(c(n = n, K = K, df = df, SSR = SSR, sigma_hat = sigma_hat,
    SST_j = SST_j, R2_j = R2_j, se_by_hand = se_j,
    se_summary = summary(reg)$coefficients[xj, 2], sigma_summary = summary(reg)$sigma))
# summary(reg)$coefficients[row, 2]: row 1 = intercept, 2 = first x, 3 = second x ...
# "Residual standard error ... on 84 degrees of freedom" = sigma-hat, and 84 = df.


# =====================================================================
# PART G — CONCEPT / MULTIPLE-CHOICE ANSWERS
# =====================================================================
#
# --- Interpretation of log models ---
#  log-level  log(y)=b0+b1x       : 1 unit of x -> 100*b1 % change in y   (%dy = 100 b1 dx)
#  log-log    log(y)=b0+b1log(x)  : 1% x -> b1 % y  (ELASTICITY)
#     e.g. log(rent)=2.1+0.45log(income): 1% income -> about 0.45% rent
#  level-log  y=b0+b1log(x)       : 1% x -> b1/100 units of y
#     e.g. test=12+8log(income): 1% income -> about 0.08 points
#  "In which model is %dy = 100*b1*dx?"  -> LOG-LEVEL (not level-level!)
#  log-log, y in dollars instead of thousands -> b1 does NOT change; only b0 changes
#  x multiplied by 10 -> slope divided by 10, intercept same, R^2 same
#
# --- Unbiasedness / variance (SLR) ---
#  E[b1-hat] = b1 means: AVERAGED over many random samples b1-hat equals b1
#     (not every sample; residuals not zero; not only when R^2=1)
#  1,000 samples, OLS unbiased -> the AVERAGE of the 1,000 estimates is close to b1
#  Prefer smaller variance because: estimates land closer to b1 from sample to
#     sample, so any one estimate is more reliable
#  Var(b1) SMALLER: more spread-out X (larger SST_X), larger sample, smaller sigma^2
#  Var(b1) LARGER: smaller sample, larger sigma^2, X bunched together. (NOT the size of b1)
#  Every worker has 12 years of educ -> SLR3 fails: X all the same, slope can't be computed
#  Spread of y around the line grows with x (food spending/income) -> SLR5
#     (homoskedasticity) fails: Var formula no longer applies, OLS STILL UNBIASED
#  Zero conditional mean (test score/class size, family income in U, richer districts
#     have smaller classes) -> FAILS, because the average of U changes with class size
#  OLS line = the one with residuals summing to 0 AND smallest sum of squared residuals
#
# --- Multiple regression ---
#  b1 in wage = b0 + b1 educ + b2 exper: change in predicted wage from one more year of
#     educ, HOLDING EXPER FIXED (ceteris paribus)
#  Residual facts ALWAYS true (select all):
#     [x] sample average of residuals is 0
#     [x] sample covariance between EACH X_j and residuals is 0
#     [x] regression passes through the point of means
#     [ ] covariance between Y and residuals is 0   (false: uncorrelated with Y-HAT, not Y)
#     [ ] every residual 0 when sample large          (false)
#  MLR3 (no perfect collinearity) VIOLATED (select all):
#     [x] wage on income in dollars AND income in thousands
#     [x] voteA on expendA, expendB and totexpend = expendA + expendB
#     [x] 5 independent variables, 4 observations (need n >= K+1)
#     [ ] educ and exper both vary                     (fine)
#     [ ] ACT and hsGPA positively but NOT perfectly correlated  (fine)
#  R output for totexpend -> "NA: R drops totexpend because it is an exact linear function"
#  MLR4 fails (endogeneity): a variable that affects Y and is correlated with X1 is
#     left out (also wrong functional form). NOT: small n, units, high correlation.
#  Why not add every variable? -> can INCREASE the variance of the OLS estimates and can
#     even violate MLR3
#
# --- Standard errors (PS12) ---
#  In se(b_j) = sigma-hat / sqrt(SST_j(1-R2_j)), X_j = the independent variable whose
#     coefficient b_j we want the standard error of
