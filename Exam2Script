# ---- A1. JOINT TABLE: find Cor(X,Y) (or Cov, E, Var) ----------------
# Example: x=3,4,6,7  y=7,11,3,10  P=.2,.3,.4,.1   ANSWER: Cor = -0.46
x <- c(3, 4, 6, 7)          # <- change these
y <- c(7, 11, 3, 10)        # <- change these
p <- c(0.2, 0.3, 0.4, 0.1)  # <- change these
