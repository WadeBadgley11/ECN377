# ---------------- #3  Degrees of freedom -----------------------------
n <- 152        # <-- CHANGE: number of observations
K <- 3          # <-- CHANGE: number of independent variables

n - K - 1       # answer


# ---------------- #4  t-statistic ------------------------------------
beta_hat <- 0.87   # <-- CHANGE: estimate
se       <- 0.83   # <-- CHANGE: standard error

round(beta_hat / se, 2)   # answer


# ---------------- #7  One-sided test decision ------------------------
t <- 1.52   # <-- CHANGE: t-statistic
c <- 1.71   # <-- CHANGE: critical value

# If H1: beta > 0, use this line:
t > c       # TRUE = Reject H0 (t > c),  FALSE = Fail to reject H0 (t < c)

# If H1: beta < 0, use this line instead (c will be negative):
# t < c     # TRUE = Reject H0 (t < c),  FALSE = Fail to reject H0 (t > c)


# ---------------- #14  bwght: t-statistic for cigs -------------------
reg14 <- lm(bwght ~ cigs + faminc, data = bwght)   # <-- CHANGE formula if needed
s14 <- summary(reg14)$coefficients
s14                      # shows the full table
round(s14[2, 3], 2)      # answer: row 2 = cigs, column 3 = t value
# (row 1 = intercept, then variables in the order they appear in lm())


