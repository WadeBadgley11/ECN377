# 9. REAL DATA: RESIDUAL FOR A GIVEN ROW
#    Change the dataset, y, x, and row number.
# =====================================================================
reg <- lm(wage ~ tenure, data = wage1)   # <-- EDIT  y ~ x, data = ...
row <- 12                                # <-- EDIT  row number
summary(reg)
cat("Residual in row", row, "=", r2(reg$residuals[row]), "\n")


# =====================================================================
# 10. REAL DATA: SSE and % of variation explained (R^2 * 100)
# =====================================================================
reg <- lm(salary ~ roe, data = ceosal1)  # <-- EDIT
yv  <- model.frame(reg)[[1]]             # the y variable used
SSE <- sum((fitted(reg) - mean(yv))^2)
cat("SSE =", r2(SSE), "  % explained =", r2(100 * summary(reg)$r.squared), "\n")


# =====================================================================
# 11. POINT (xbar, ybar) IS ON THE OLS LINE
#     ybar = b0 + b1 * xbar
# =====================================================================
b0 <- 5        # <-- EDIT  intercept
b1 <- 2.4      # <-- EDIT  slope
xbar <- 11     # <-- EDIT  mean of x
cat("ybar =", r2(b0 + b1 * xbar), "\n")


# =====================================================================
# 12. RESCALING (units changes)
#     y multiplied by c -> b0 AND b1 multiplied by c
#     x multiplied by c -> b1 divided by c, b0 unchanged
#     Dividing by k is the same as multiplying by c = 1/k
#     R^2 and correlation NEVER change from rescaling.
# =====================================================================
# --- 12a. y rescaled ---
b1 <- 1.72     # <-- EDIT  original slope
c_y <- 1000    # <-- EDIT  what y is multiplied by
cat("New slope (y rescaled) =", r2(b1 * c_y), "\n")

# --- 12b. x rescaled ---
b1 <- 0.03     # <-- EDIT  original slope
c_x <- 1/100   # <-- EDIT  what x is multiplied by (divide by 100 -> 1/100)
cat("New slope (x rescaled) =", r2(b1 / c_x), "\n")

# --- 12c. Real data: rescale y and rerun ---
b <- coef(lm(salary ~ sales, data = ceosal1))["sales"]   # <-- EDIT
c_y <- 1000                                              # <-- EDIT  thousands -> dollars
cat("Original slope =", b, "  New slope =", r2(b * c_y), "\n")

# --- 12d. Covariance after rescaling (correlation stays the same) ---
cov_orig <- 6200   # <-- EDIT  original covariance
c_x <- 1/1000      # <-- EDIT  dollars -> thousands of dollars
cat("New covariance =", r2(cov_orig * c_x), " (correlation unchanged)\n")


# =====================================================================
# 13. LOG MODELS — interpreting the slope
#     level-level:  dy  = b1 * dx
#     log-level:    %dy ≈ 100 * b1 * dx
#     level-log:    dy  ≈ (b1/100) * %dx
#     log-log:      %dy ≈ b1 * %dx       (b1 is an elasticity)
# =====================================================================
b1 <- 0.02;  dx  <- 3     # <-- EDIT  log-level
cat("log-level   %change in y =", r2(100 * b1 * dx), "\n")

b1 <- 0.27;  pdx <- 7     # <-- EDIT  log-log  (pdx = % change in x)
cat("log-log     %change in y =", r2(b1 * pdx), "\n")

b1 <- 11.3;  pdx <- 13    # <-- EDIT  level-log
cat("level-log   change in y  =", r2(b1/100 * pdx), "\n")

# --- Real data log-level ---
b <- coef(lm(log(wage) ~ exper, data = wage1))["exper"]   # <-- EDIT
dx <- 10                                                   # <-- EDIT
cat("Slope =", b, "  %change in wage =", r2(100 * b * dx), "\n")


# =====================================================================
# 14. LINEAR EQUATION CHANGE  (y = b0 + b1*X1 + b2*X2)
#     dy = b1*dX1 + b2*dX2
# =====================================================================
b1 <- 1.5;  dX1 <- 4      # <-- EDIT
b2 <- -0.8; dX2 <- -3     # <-- EDIT  (falls by 3 -> -3)
cat("Change in y =", r2(b1*dX1 + b2*dX2), "\n")


