# install.packages("wooldridge")   # run once if not installed
library(wooldridge)

r2 <- function(v) round(v, 2)      # rounds to 2 decimal places


# =====================================================================
# 1. STANDARD DEVIATION OF aX + b
#    Var(X) = E[X^2] - (E[X])^2
#    sd(aX + b) = |a| * sd(X)      (b shifts, but does not spread)
# =====================================================================
EX  <- 1       # <-- EDIT  E[X]
EX2 <- 37      # <-- EDIT  E[X^2]
a   <- 3       # <-- EDIT  multiplier on X   (b doesn't matter)

varX <- EX2 - EX^2
cat("Q1-type  sd(aX+b) =", r2(abs(a) * sqrt(varX)), "\n")


# =====================================================================
# 2. VARIANCE OF aX + bY
#    Var(aX + bY) = a^2 Var(X) + b^2 Var(Y) + 2ab Cov(X,Y)
#    Careful: for 2X - 2Y, b = -2 (negative!)
# =====================================================================
varX <- 3      # <-- EDIT  Var(X)
varY <- 2      # <-- EDIT  Var(Y)
covXY <- -0.6  # <-- EDIT  Cov(X,Y)
a <- 2         # <-- EDIT  coefficient on X
b <- -2        # <-- EDIT  coefficient on Y (include the sign)

cat("Var(aX+bY) =", r2(a^2*varX + b^2*varY + 2*a*b*covXY), "\n")


# =====================================================================
# 3. CORRELATION FROM A JOINT PROBABILITY TABLE
#    Cov = E[XY] - E[X]E[Y]
#    Cor = Cov / (sd(X) * sd(Y))
#    Every term is weighted by its probability.
#    (Do NOT use cor(x, y) — it ignores the probabilities.)
# =====================================================================
x <- c(3, 4, 6, 7)            # <-- EDIT  x column
y <- c(7, 11, 3, 10)          # <-- EDIT  y column
p <- c(0.2, 0.3, 0.4, 0.1)    # <-- EDIT  probability column (must sum to 1)

Ex  <- sum(p * x)
Ey  <- sum(p * y)
cov_xy <- sum(p * x * y) - Ex * Ey
sd_x   <- sqrt(sum(p * x^2) - Ex^2)
sd_y   <- sqrt(sum(p * y^2) - Ey^2)
cat("E[X] =", Ex, " E[Y] =", Ey, " Cov =", r2(cov_xy), "\n")
cat("Cor(X,Y) =", r2(cov_xy / (sd_x * sd_y)), "\n")


# =====================================================================
# 4. CONDITIONAL MEAN / VARIANCE (given X = x, Y takes values ...)
#    E[cY + d | X] = c*E[Y|X] + d
#    Var(Y | X)    = E[Y^2|X] - (E[Y|X])^2
# =====================================================================
yvals <- c(4, 10, 16)         # <-- EDIT  values Y can take
probs <- c(0.25, 0.5, 0.25)   # <-- EDIT  their probabilities
cc <- 3; dd <- -2             # <-- EDIT  for E[3Y - 2 | X], c = 3, d = -2

EY  <- sum(probs * yvals)
cat("E[cY+d | X] =", r2(cc*EY + dd), "\n")
cat("Var(Y | X)  =", r2(sum(probs * yvals^2) - EY^2), "\n")


# =====================================================================
# 5. OLS RESIDUAL OF ONE OBSERVATION (small sample)
#    residual = actual y - fitted y
# =====================================================================
x <- c(2, 4, 6, 7, 8)         # <-- EDIT  x values
y <- c(8, 10, 12, 11, 9)      # <-- EDIT  y values
obs <- 3                      # <-- EDIT  which observation (3rd, 4th, ...)

fit <- lm(y ~ x)
print(coef(fit))              # intercept and slope, if you need them
cat("Residual of obs", obs, "=", r2(resid(fit)[obs]), "\n")


# =====================================================================
# 6. MISSING RESIDUAL  (OLS residuals always sum to zero)
# =====================================================================
known_resids <- c(-1.2, 2.7, -0.9, -1.7, 2.7)   # <-- EDIT  the residuals you know
cat("Missing residual =", r2(-sum(known_resids)), "\n")


# =====================================================================
# 7. SUM OF x_i * u_hat_i   (always 0 by OLS — no computing needed)
#    Code below just confirms it. A result like -8.7e-15 means 0.
# =====================================================================
x <- c(1, 9, 11, 12, 14, 15)   # <-- EDIT
y <- c(11, 7, 6, 8, 7, 14)     # <-- EDIT
cat("sum(x * u_hat) =", r2(sum(x * resid(lm(y ~ x)))), "\n")


# =====================================================================
# 8. SUMS OF SQUARES
#    SST = SSE + SSR,   R^2 = SSE/SST = 1 - SSR/SST
#    (SSE = explained, SSR = residual, in this class's notation)
# =====================================================================
# --- 8a. Given SSE and R^2, find SSR ---
SSE <- 98      # <-- EDIT
R2  <- 0.26    # <-- EDIT
SST <- SSE / R2
cat("SST =", r2(SST), "  SSR =", r2(SST - SSE), "\n")

# --- 8b. Given n and sample variance, find SST (and R^2 if SSR given) ---
n   <- 10      # <-- EDIT  sample size
S2y <- 28      # <-- EDIT  sample variance of y
SSR <- NA      # <-- EDIT  put SSR here if the question gives one, else leave NA
SST <- S2y * (n - 1)
cat("SST =", r2(SST), "\n")
if (!is.na(SSR)) cat("R^2 =", r2(1 - SSR/SST), "\n")


