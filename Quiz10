library(wooldridge)  # loads wage1 and bwght data


# ================= PROBLEM 1 (log-level, two x's) ========
# %change y = 100 * (b1*dx1 + b2*dx2)
b1  <- 0.034;  b2  <- -0.014   # PLUG IN: slopes (keep signs!)
dx1 <- 4;      dx2 <- 3        # PLUG IN: changes (falls = negative)
round(100 * (b1*dx1 + b2*dx2), 2)   # percent change in y
# ANSWER: 9.4


# ================= PROBLEM 2 (wage1, % change) ===========
d_educ   <- 0   # PLUG IN: change in educ
d_exper  <- 2   # PLUG IN: change in exper
d_tenure <- 1   # PLUG IN: change in tenure
reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1)  # log-level regression
b <- reg$coefficients                                        # saves coefficients
round(100 * (b[2]*d_educ + b[3]*d_exper + b[4]*d_tenure), 2) # percent change in wage
# ANSWER: 3.03


# ================= PROBLEM 3 (wage1, predicted wage) =====
educ_val <- 12;  exper_val <- 10;  tenure_val <- 3   # PLUG IN: worker values
reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1)  # same regression
b <- reg$coefficients                                        # saves coefficients
round(exp(b[1] + b[2]*educ_val + b[3]*exper_val + b[4]*tenure_val), 2)  # undo log
# ANSWER: 4.46


