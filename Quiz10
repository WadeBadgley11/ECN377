# ================= PROBLEM 11 (formula 3.23) =============
# simple = multiple + b2*delta1   ->   multiple = simple - b2*delta1
b1_simple <- 0.79    # PLUG IN: simple-regression slope (beta tilde)
b2        <- -1.24   # PLUG IN: beta2 hat
delta1    <- 0.49    # PLUG IN: delta1 tilde
round(b1_simple - b2*delta1, 2)   # multiple-regression slope
# ANSWER: 1.40
# If the quiz asks for the SIMPLE slope instead:  b1_multiple + b2*delta1


# ================= PROBLEM 14 (bwght, b2 * delta1) =======
reg_mult <- lm(bwght ~ cigs + faminc, data = bwght)  # multiple regression
reg_aux  <- lm(faminc ~ cigs, data = bwght)          # omitted var on included
b2     <- coef(reg_mult)["faminc"]                   # faminc coefficient
delta1 <- coef(reg_aux)["cigs"]                      # cigs slope
round(b2 * delta1, 2)                                # bias piece
# ANSWER: -0.05
# Check: simple cigs slope minus multiple cigs slope
coef(lm(bwght ~ cigs, data = bwght))["cigs"] - coef(reg_mult)["cigs"]


# ================= PROBLEMS 16 & 17 (sign of bias) =======
# Bias = sign(beta2) * sign(delta1)
#   beta2  = effect of omitted X2 on Y     (+1 raises, -1 lowers)
#   delta1 = correlation of X2 with X1     (+1 positive, -1 negative)
beta2_sign  <- -1   # PLUG IN: +1 or -1   (Problem 16: X2 lowers Y)
delta1_sign <- -1   # PLUG IN: +1 or -1   (Problem 16: negatively correlated)
bias <- beta2_sign * delta1_sign
if (bias > 0) "biased UPWARD (overstates)" else "biased DOWNWARD (understates)"
# If either leg is 0 -> UNBIASED
# ANSWER 16: biased upward
# ANSWER 17: land raises yield (+1), more fertilizer on good land (+1)
#            -> overstates the effect of fertilizer (upward bias)
