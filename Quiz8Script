# =============================================================================
# PS9 #13 — WHAT MAKES Var(b1) SMALLER?  (multiple choice)
# -----------------------------------------------------------------------------
# Var(b1) = sigma^2 / SST_x
#   smaller sigma^2  -> smaller variance
#   bigger SST_x (more spread in x, or bigger n) -> smaller variance
#   intercept has nothing to do with it
#
# ANSWER: "More spread-out values of X (a larger SST_x)."
# =============================================================================


# =============================================================================
# PS9 #14 — sd(b1) FROM A LIST OF x VALUES
# -----------------------------------------------------------------------------
# SST_x = sum((x - mean(x))^2),   sd(b1) = sigma / sqrt(SST_x)
# =============================================================================
# ---- PLUG IN ----
sigma <- 5
x     <- c(4, 5, 6, 7, 9)

SST_x <- sum((x - mean(x))^2)
cat("PS9 #14  SST_x =", SST_x, " ->  sd(b1) =", r2(sigma / sqrt(SST_x)), "\n")

# Variants that may show up:
#   Var(b1) = sigma^2 / SST_x                 -> r2(80 / 17)
#   SST_x from n and sample var: (n-1)*S2     -> r2(9 / sqrt((8 - 1) * 5))


# =============================================================================
# PS9 #15 — ESTIMATE OF ERROR VARIANCE
# -----------------------------------------------------------------------------
# sigma_hat^2 = SSR / (n - 2)      (divide by n-2, NOT n or n-1)
# =============================================================================
# ---- PLUG IN ----
n   <- 20
SSR <- 388
cat("PS9 #15  sigma_hat^2 =", r2(SSR / (n - 2)), "\n")


# =============================================================================
# PS9 #16 — STANDARD ERROR OF b1
# -----------------------------------------------------------------------------
# sigma_hat = sqrt(SSR / (n - 2)),   se(b1) = sigma_hat / sqrt(SST_x)
# =============================================================================
# ---- PLUG IN ----
n     <- 8
SSR   <- 457
SST_x <- 13

sigma_hat <- sqrt(SSR / (n - 2))
cat("PS9 #16  sigma_hat =", r2(sigma_hat), " ->  se(b1) =", r2(sigma_hat / sqrt(SST_x)), "\n")


