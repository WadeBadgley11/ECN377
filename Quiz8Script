# =============================================================================
# PS9 #1 — RESCALING y IN A LOG-LOG MODEL  (multiple choice)
# -----------------------------------------------------------------------------
# log(c*y) = log(c) + log(y)  -> only the INTERCEPT changes (by + log(c)).
# The slope b1 is a % effect, so it does NOT change.
#
# ANSWER: "b1 does not change; only b0 changes."
#
# Bonus: new intercept = old b0 + log(c)
#   e.g. salary thousands -> dollars:  4.93 + log(1000) = 11.84
# =============================================================================
new_intercept_log_y <- function(b0, multiply_by) r2(b0 + log(multiply_by))
cat("PS9 #1  (bonus) new intercept =", new_intercept_log_y(4.93, 1000), "\n")


# =============================================================================
# PS9 #5 — LOG-LOG WITH A FALL IN x
# -----------------------------------------------------------------------------
# Rule: %Δy ≈ b1 * %Δx   — a FALL means %Δx is NEGATIVE
# =============================================================================
# ---- PLUG IN ----
b1     <- 0.23
pct_dx <- -2        # "falls by 2%"  ->  -2
cat("PS9 #5  %Δy ≈", log_log(b1, pct_dx), "%\n")


# =============================================================================
# PS9 #6 — LOG-LEVEL WITH REAL DATA (ceosal1)
# -----------------------------------------------------------------------------
# Run the regression, grab the UNROUNDED slope, then %Δy ≈ 100 * b1 * Δx
# =============================================================================
# install.packages("wooldridge")   # run once if you don't have it
library(wooldridge)
data("ceosal1")

reg6 <- lm(log(salary) ~ roe, data = ceosal1)
b1_6 <- coef(reg6)["roe"]           # unrounded slope (≈ 0.013863)

# ---- PLUG IN ----
d_roe <- 5                           # roe rises by this many points
cat("PS9 #6  slope =", b1_6, " ->  %Δsalary ≈", log_level(b1_6, d_roe), "%\n")

