r2 <- function(x) round(x, 2)   # round to hundredths

# =============================================================================
# PS8 #14 — RESCALING x (divide or multiply every x by a number)
# -----------------------------------------------------------------------------
# Rule: if x is MULTIPLIED by c, the slope is multiplied by 1/c.
#       if x is DIVIDED   by k, the slope is MULTIPLIED by k.
#       The intercept and R^2 do not change.
# =============================================================================
rescale_x_slope <- function(b1, divide_by = NULL, multiply_by = NULL) {
  if (!is.null(divide_by))   return(r2(b1 * divide_by))
  if (!is.null(multiply_by)) return(r2(b1 / multiply_by))
  stop("Give divide_by OR multiply_by")
}

# ---- PLUG IN ----
b1        <- 0.03   # original slope
divisor   <- 100    # every x divided by this
cat("PS8 #14  New slope =", rescale_x_slope(b1, divide_by = divisor), "\n")
# If the quiz says x is MULTIPLIED instead, use:
# rescale_x_slope(b1, multiply_by = 10)

# Bonus (rescaling y): if y is multiplied by c, slope AND intercept are multiplied by c.
rescale_y_slope <- function(b1, multiply_by) r2(b1 * multiply_by)
# e.g. salary in thousands -> dollars:  rescale_y_slope(0.01547, 1000)  -> 15.47


# =============================================================================
# PS8 #17 — LOG-LEVEL:  log(y) = b0 + b1*x
# -----------------------------------------------------------------------------
# Rule: %Δy ≈ 100 * b1 * Δx
# =============================================================================
log_level <- function(b1, dx) r2(100 * b1 * dx)

# ---- PLUG IN ----
b1 <- 0.02   # slope on x
dx <- 3      # how much x rises (units)
cat("PS8 #17  %Δy ≈", log_level(b1, dx), "%\n")


# =============================================================================
# PS8 #19 — LEVEL-LOG:  y = b0 + b1*log(x)
# -----------------------------------------------------------------------------
# Rule: Δy ≈ (b1 / 100) * %Δx
# =============================================================================
level_log <- function(b1, pct_dx) r2((b1 / 100) * pct_dx)

# ---- PLUG IN ----
b1     <- 11.3   # slope on log(x)
pct_dx <- 13     # % rise in x
cat("PS8 #19  Δy ≈", level_log(b1, pct_dx), "units\n")


# =============================================================================
# EXTRA (in case it shows up) — LOG-LOG:  log(y) = b0 + b1*log(x)
# -----------------------------------------------------------------------------
# Rule: %Δy ≈ b1 * %Δx   (b1 is an elasticity)
# =============================================================================
log_log <- function(b1, pct_dx) r2(b1 * pct_dx)
# e.g. log_log(0.27, 7) -> 1.89


